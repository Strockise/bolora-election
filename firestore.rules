rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  বলোড়া হিলফুল ফুজুল — নির্বাচন ব্যবস্থার নিরাপত্তা নিয়ম
//
//  এই নিয়মগুলো Google-এর সার্ভারে চলে, তাই কেউ ব্রাউজার থেকে
//  কোড বদলেও এগুলো ভাঙতে পারবে না।
//
//  মূল নীতি:
//   1. এক Google অ্যাকাউন্ট = এক নির্বাচনে একটিই ভোট।
//   2. কে কাকে ভোট দিয়েছে তা কোথাও সংরক্ষিত হয় না। শুধু প্রত্যেক
//      প্রার্থীর মোট সংখ্যা (count) এক করে বাড়ে।
//   3. অ্যাডমিনরাও ভোটের সংখ্যা হাতে বদলাতে পারেন না।
//   4. ফলাফল শুধু ভোটগ্রহণ শেষ হওয়ার পর দেখা যায় (তখনই সবার জন্য প্রকাশিত); ভোট চলাকালীন অ্যাডমিনও দেখতে পারেন না।
//
//  অ্যাডমিন: admins সংগ্রহে যাঁদের Gmail আছে, সবার ক্ষমতা সমান।
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    // অ্যাডমিন = admins তালিকায় যাঁর Gmail আছে। সব অ্যাডমিনের ক্ষমতা সমান।
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }

    function settings() { return get(/databases/$(database)/documents/settings/app).data; }
    function election(eid) { return get(/databases/$(database)/documents/elections/$(eid)).data; }
    function boxPath(eid) { return /databases/$(database)/documents/elections/$(eid)/meta/box; }
    function voterPath(eid) { return /databases/$(database)/documents/elections/$(eid)/voters/$(request.auth.uid); }
    // একই অনুরোধে নির্বাচনটিও মুছে যাচ্ছে কিনা (তখনই শুধু ভেতরের তথ্য মোছা যায়)
    function electionGone(eid) { return !existsAfter(/databases/$(database)/documents/elections/$(eid)); }
    function tallyPath(eid, cid) { return /databases/$(database)/documents/elections/$(eid)/tally/$(cid); }

    // শুধু অ্যাডমিনের অনুমোদিত ভোটার (members তালিকা) ভোট দিতে পারবেন
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(myEmail()));
    }
    function allowedVoter() { return isMember(); }
    function canVote(eid) { return allowedVoter() && election(eid).status == 'open'; }

    // এই একই অনুরোধে (batch) ভোটারের রসিদ তৈরি হচ্ছে, আগে ছিল না
    function votingNow(eid) { return !exists(voterPath(eid)) && existsAfter(voterPath(eid)); }

    // ব্যালট বাক্সে একটিই পছন্দ, আর ঠিক সেই প্রার্থীর সংখ্যা ঠিক ১ বেড়েছে
    function ballotOk(eid) {
      let after = getAfter(boxPath(eid)).data;
      let before = get(boxPath(eid)).data;
      let p = after.pick;
      return p in election(eid).candidateIds
        && after.n != before.n
        && getAfter(tallyPath(eid, p)).data.count == get(tallyPath(eid, p)).data.count + 1;
    }

    // ── সাধারণ সেটিংস ─────────────────────────────
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── অ্যাডমিন তালিকা ──
    // যে কোনো অ্যাডমিন নতুন অ্যাডমিন যোগ করতে ও অন্য অ্যাডমিনকে বাদ দিতে পারেন
    // (নিজেকে বাদ দেওয়া যায় না, তাই সবসময় অন্তত একজন অ্যাডমিন থাকেন)
    match /admins/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create, update: if isAdmin() && email == email.lower() && email.matches('^[^@\\s]+@[^@\\s]+$');
      allow delete: if isAdmin() && email != myEmail();
    }

    // ── ভোটার তালিকা (ঐচ্ছিক) ─────────────────────
    match /members/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create, delete: if isAdmin();
      // অ্যাডমিন সব বদলাতে পারেন; সদস্য নিজে শুধু নিজের প্রোফাইল ছবির লিংক হালনাগাদ করতে পারেন
      allow update: if isAdmin()
        || (signedIn() && email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
            && request.resource.data.photo is string
            && request.resource.data.photo.size() <= 600);
    }

    // ── ভোটার নিবন্ধনের আবেদন ──────────────────
    // প্রথমবার ভোটার হিসেবে লগইন করলে নিজের আবেদন জমা পড়ে; অ্যাডমিন অনুমোদন/বাতিল করেন।
    match /requests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'status', 'at'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 600))
        && request.resource.data.email == myEmail()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time;
      allow update, delete: if isAdmin();
    }

    // ── নির্বাচন ─────────────────────────────────
    match /elections/{eid} {
      // লিংকের কোড (নির্বাচনের id) জানলেই শুধু একটি নির্বাচন খোলা যায়;
      // সব নির্বাচনের তালিকা শুধু অ্যাডমিন দেখতে পারেন।
      allow get: if true;
      allow list: if isAdmin() || (isMember() && resource.data.status in ['open', 'closed']);
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin()
        && request.resource.data.status in ['draft', 'open', 'closed']
        && !(resource.data.status != 'draft' && request.resource.data.status == 'draft')
        && (resource.data.status == 'draft'
            || (request.resource.data.candidateIds == resource.data.candidateIds
                && request.resource.data.candidates == resource.data.candidates));
      // যে কোনো অ্যাডমিন খসড়া বা শেষ হওয়া নির্বাচন মুছতে পারেন (চলমান নির্বাচন নয়)
      allow delete: if isAdmin() && resource.data.status != 'open';

      // ব্যালট বাক্স: কেউ পড়তে পারে না, শুধু নিয়ম যাচাইয়ে ব্যবহার হয়
      match /meta/box {
        allow read: if false;
        allow create: if isAdmin() && request.resource.data.pick == '';
        allow update: if (canVote(eid)
              && votingNow(eid)
              && request.resource.data.keys().hasOnly(['pick', 'n'])
              && request.resource.data.pick in election(eid).candidateIds
              && request.resource.data.n != resource.data.n)
          || (isAdmin() && request.resource.data.pick == '');
        allow delete: if isAdmin() && electionGone(eid);
      }

      // প্রার্থী-ভিত্তিক মোট ভোট (কে দিয়েছে তা নেই)
      match /tally/{cid} {
        // ভোট চলাকালীন কেউই (অ্যাডমিনও) ফলাফল পড়তে পারেন না;
        // ভোটগ্রহণ শেষ হলেই ফলাফল অ্যাডমিন ও সব অনুমোদিত ভোটারের জন্য প্রকাশিত
        allow read: if election(eid).status == 'closed' && (isAdmin() || isMember());
        allow create: if isAdmin()
          && cid in election(eid).candidateIds
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count == 0;
        allow update: if canVote(eid)
          && votingNow(eid)
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count == resource.data.count + 1
          && getAfter(boxPath(eid)).data.pick == cid;
        allow delete: if isAdmin() && electionGone(eid);
      }

      // কে ভোট দিয়েছেন (কাকে দিয়েছেন তা নয়)। একবার তৈরি হলে আর বদলানো যায় না।
      match /voters/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if canVote(eid)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'name'])
          && request.resource.data.email == myEmail()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && ballotOk(eid);
        allow update: if false;
        allow delete: if isAdmin() && electionGone(eid);
      }
    }
  }
}
